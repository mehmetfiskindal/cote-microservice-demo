{
  "name": "order-processing-microservices-v3",
  "version": "1.0.0",
  "private": true,
  "description": "V3 event-driven microservice demo with TypeScript, cote.js, Prisma, PostgreSQL, retries and compensation.",
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:order\" \"npm run dev:payment\" \"npm run dev:inventory\" \"npm run dev:notification\" \"npm run dev:monitoring\"",
    "dev:api": "tsx watch apps/api-gateway/src/index.ts",
    "dev:order": "tsx watch apps/order-service/src/index.ts",
    "dev:payment": "tsx watch apps/payment-service/src/index.ts",
    "dev:inventory": "tsx watch apps/inventory-service/src/index.ts",
    "dev:notification": "tsx watch apps/notification-service/src/index.ts",
    "dev:monitoring": "tsx watch apps/monitoring-service/src/index.ts",
    "dev:dashboard": "npm run dev --prefix apps/monitoring-dashboard",
    "build": "tsc --noEmit",
    "prisma:generate": "npm run prisma:generate:order && npm run prisma:generate:payment && npm run prisma:generate:inventory && npm run prisma:generate:notification && npm run prisma:generate:monitoring",
    "prisma:generate:order": "prisma generate --schema apps/order-service/prisma/schema.prisma",
    "prisma:generate:payment": "prisma generate --schema apps/payment-service/prisma/schema.prisma",
    "prisma:generate:inventory": "prisma generate --schema apps/inventory-service/prisma/schema.prisma",
    "prisma:generate:notification": "prisma generate --schema apps/notification-service/prisma/schema.prisma",
    "prisma:generate:monitoring": "prisma generate --schema apps/monitoring-service/prisma/schema.prisma",
    "db:push": "npm run db:push:order && npm run db:push:payment && npm run db:push:inventory && npm run db:push:notification",
    "db:push:order": "prisma db push --schema apps/order-service/prisma/schema.prisma",
    "db:push:payment": "prisma db push --schema apps/payment-service/prisma/schema.prisma",
    "db:push:inventory": "prisma db push --schema apps/inventory-service/prisma/schema.prisma",
    "db:push:notification": "prisma db push --schema apps/notification-service/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.18.0",
    "cors": "^2.8.5",
    "cote": "^1.2.0",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^8.2.2",
    "prisma": "^6.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
