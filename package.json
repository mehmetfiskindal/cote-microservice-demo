{
  "name": "cote-microservice-demo",
  "version": "1.0.0",
  "description": "A demo microservice architecture using Node.js, Express.js and cote.js",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:order\" \"npm run dev:payment\" \"npm run dev:inventory\" \"npm run dev:notification\"",
    "dev:api": "nodemon apps/api-gateway/src/index.js",
    "dev:order": "nodemon apps/order-service/src/index.js",
    "dev:payment": "nodemon apps/payment-service/src/index.js",
    "dev:inventory": "nodemon apps/inventory-service/src/index.js",
    "dev:notification": "nodemon apps/notification-service/src/index.js",
    "start": "npm run dev"
  },
  "keywords": [
    "microservices",
    "cote",
    "nodejs",
    "express",
    "event-driven"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "cote": "^1.2.0",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  }
}